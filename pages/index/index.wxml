<!-- index.wxml -->
<view class="index-header" style="padding-top: {{headerPaddingTop}}px;">
  <view class="header-top">
    <view class="header-logo">
      <image class="logo" src="/assets/logo/logo.png" mode="aspectFit"></image>
      <view class="logo-text">
        <text class="text-2">食推</text>
        <text class="text-4">小智</text>
      </view>
      <!-- <image class="logo-text" src="/assets/logo/logo-text.png" mode="aspectFit"></image> -->
    </view>
  </view>
  <!-- <view class="header-slogan">
    <text>你的每日食谱推荐贴心助手</text>
  </view> -->
  <view class="search-container">
    <view class="search-box">
      <image class="search-icon" src="/assets/index/home-search.png" mode="aspectFit"></image>
      <input class="search-input" placeholder="搜索食谱或食物" placeholder-style="color: #999;" confirm-type="search" bindconfirm="onSearch" value="{{searchKeyword}}" bindinput="onSearchInput" />
      <view class="search-divider"></view>
      <view class="search-btn" bindtap="onSearchBtn">
        <text>搜索</text>
      </view>
    </view>
  </view>
</view>
<scroll-view class="scrollarea" scroll-y type="list" bindtap="onPageTap">
  <view class="container">
    <!-- 轮播图 -->
    <view class="banner-section">
      <swiper class="banner-swiper" indicator-dots indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#B6CF99" autoplay circular interval="5000">
        <swiper-item wx:for="{{banners}}" wx:key="id">
          <image class="banner-image" src="{{item.image}}" mode="aspectFill"></image>
        </swiper-item>
      </swiper>
    </view>
    <!-- 今日食谱卡片 -->
    <view class="today-recipe-wrapper">
      <!-- AI智能生成按钮 -->
      <view class="ai-generate-btn {{recipeCardExpanded ? 'expanded' : 'collapsed'}}" bindtap="toggleRecipeCard">
        <view class="ai-icon">
          <image src="/assets/index/icon-today.png" mode="aspectFit"></image>
        </view>
        <text class="ai-text">{{recipeCardExpanded ? '收起今日食谱' : '查看今日食谱'}}</text>
        <view class="ai-arrow {{recipeCardExpanded ? 'expanded' : ''}}">
          <image src="/assets/index/{{recipeCardExpanded ? 'icon-down' : 'icon-right'}}.png" mode="aspectFit"></image>
        </view>
      </view>
      
      <!-- 加载状态 - 使用动态按钮 -->
      <view class="recipe-loading-container {{recipeCardExpanded ? 'expanded' : 'collapsed'}}" wx:if="{{isLoadingRecipe || isGenerating}}">
        <view class="ai-generate-icon generating">
          <view class="generate-bg"></view>
          <view class="generate-glow"></view>
          <image class="generate-icon" src="/assets/index/icon-generate.png" mode="aspectFit"></image>
          <view class="generate-particles">
            <view class="particle particle-1"></view>
            <view class="particle particle-2"></view>
            <view class="particle particle-3"></view>
            <view class="particle particle-4"></view>
          </view>
        </view>
        <text class="loading-text">小智正在给你规划今日食谱中...</text>
      </view>
      
      <!-- 今日食谱卡片 -->
      <view class="today-recipe-card {{recipeCardExpanded ? 'expanded' : 'collapsed'}}" wx:if="{{!isLoadingRecipe && !isGenerating && todayRecipe}}">
        <!-- 卡片头部 -->
        <view class="recipe-card-header">
          <view class="recipe-title-row">
            <view class="title-left">
              <text class="recipe-title">{{todayRecipe.title}}</text>
              <view class="recipe-date">
                <text class="date-text">{{todayRecipe.date}}</text>
                <text class="weekday-text">{{todayRecipe.weekday}}</text>
              </view>
            </view>
            <view class="title-right">
              <view class="ai-generate-icon {{isGenerating ? 'generating' : ''}}" catchtap="onAIGenerate">
                <view class="generate-bg"></view>
                <view class="generate-glow"></view>
                <image class="generate-icon" src="/assets/index/icon-generate.png" mode="aspectFit"></image>
                <view class="generate-particles">
                  <view class="particle particle-1"></view>
                  <view class="particle particle-2"></view>
                  <view class="particle particle-3"></view>
                  <view class="particle particle-4"></view>
                </view>
              </view>
            </view>
          </view>
          <text class="recipe-description">{{todayRecipe.description}}</text>
        </view>
        <!-- 营养数据统计 -->
        <view class="recipe-stats">
          <view class="stat-item">
            <text class="stat-value">{{todayRecipe.totalCalories}}</text>
            <text class="stat-label">总热量(千卡)</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-value">{{todayRecipe.totalProtein}}g</text>
            <text class="stat-label">蛋白质</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-value">{{todayRecipe.totalCarbs}}g</text>
            <text class="stat-label">碳水</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-value">{{todayRecipe.totalFat}}g</text>
            <text class="stat-label">脂肪</text>
          </view>
        </view>
        <!-- 早餐 -->
        <view class="meal-section">
          <view class="meal-header">
            <image class="meal-icon" src="/assets/index/icon-zaocan.png" mode="aspectFit"></image>
            <text class="meal-time">{{todayRecipe.meals.breakfast.time}}</text>
            <text class="meal-time-range">{{todayRecipe.meals.breakfast.timeRange}}</text>
            <text class="meal-calories">{{todayRecipe.meals.breakfast.calories}}千卡</text>
          </view>
          <view class="food-list-vertical" wx:if="{{todayRecipe.meals.breakfast.foods.length > 0}}">
            <view class="food-item-horizontal {{editingMealType === 'breakfast' && editingItemIndex === index ? 'editing' : ''}}" 
                  wx:for="{{todayRecipe.meals.breakfast.foods}}" 
                  wx:key="id" 
                  bindlongpress="onFoodLongPress"
                  catchtap="{{editingMealType === 'breakfast' && editingItemIndex === index ? 'cancelEdit' : 'navigateToRecipeDetail'}}"
                  data-meal-type="breakfast"
                  data-index="{{index}}"
                  data-id="{{item.id}}">
              <image class="food-item-image" src="{{item.image}}" mode="aspectFill"></image>
              <view class="food-item-content">
                <view class="food-item-header">
                  <text class="food-item-name">{{item.name}}</text>
                  <text class="food-item-amount">{{item.amount}}</text>
                </view>
                <view class="food-item-body">
                  <view class="food-item-nutrients">
                    <view class="nutrient-tag">
                      <text class="nutrient-icon">🔥</text>
                      <text class="nutrient-text">{{item.calories}}千卡</text>
                    </view>
                    <view class="nutrient-tag">
                      <text class="nutrient-icon">💪</text>
                      <text class="nutrient-text">{{item.protein}}g蛋白</text>
                    </view>
                    <view class="nutrient-tag">
                      <text class="nutrient-icon">🍚</text>
                      <text class="nutrient-text">{{item.carbs}}g碳水</text>
                    </view>
                    <view class="nutrient-tag">
                      <text class="nutrient-icon">🥑</text>
                      <text class="nutrient-text">{{item.fat}}g脂肪</text>
                    </view>
                  </view>
                  <view class="food-category">{{item.category}}</view>
                </view>
              </view>
              
              <!-- 删除按钮 -->
              <view class="food-actions">
                <view class="food-action-btn delete" catchtap="deleteFoodItem" data-meal-type="breakfast" data-index="{{index}}">
                  <image class="action-icon" src="/assets/health-profile/icon-delete.png" mode="aspectFit"></image>
                </view>
              </view>
            </view>
          </view>
          
          <!-- 空状态 -->
          <view class="meal-empty-state" wx:else bindtap="addRecipe" data-meal-type="breakfast">
            <image class="empty-icon" src="/assets/index/icon-zaocan.png" mode="aspectFit"></image>
            <text class="empty-text">暂无早餐食谱，点击添加</text>
          </view>
        </view>
        <!-- 午餐 -->
        <view class="meal-section">
          <view class="meal-header">
            <image class="meal-icon" src="/assets/index/icon-wucan.png" mode="aspectFit"></image>
            <text class="meal-time">{{todayRecipe.meals.lunch.time}}</text>
            <text class="meal-time-range">{{todayRecipe.meals.lunch.timeRange}}</text>
            <text class="meal-calories">{{todayRecipe.meals.lunch.calories}}千卡</text>
          </view>
          <view class="food-list-vertical" wx:if="{{todayRecipe.meals.lunch.foods.length > 0}}">
            <view class="food-item-horizontal {{editingMealType === 'lunch' && editingItemIndex === index ? 'editing' : ''}}" 
                  wx:for="{{todayRecipe.meals.lunch.foods}}" 
                  wx:key="id" 
                  bindlongpress="onFoodLongPress"
                  catchtap="{{editingMealType === 'lunch' && editingItemIndex === index ? 'cancelEdit' : 'navigateToRecipeDetail'}}"
                  data-meal-type="lunch"
                  data-index="{{index}}"
                  data-id="{{item.id}}">
              <image class="food-item-image" src="{{item.image}}" mode="aspectFill"></image>
              <view class="food-item-content">
                <view class="food-item-header">
                  <text class="food-item-name">{{item.name}}</text>
                  <text class="food-item-amount">{{item.amount}}</text>
                </view>
                <view class="food-item-body">
                  <view class="food-item-nutrients">
                    <view class="nutrient-tag">
                      <text class="nutrient-icon">🔥</text>
                      <text class="nutrient-text">{{item.calories}}千卡</text>
                    </view>
                    <view class="nutrient-tag">
                      <text class="nutrient-icon">💪</text>
                      <text class="nutrient-text">{{item.protein}}g蛋白</text>
                    </view>
                    <view class="nutrient-tag">
                      <text class="nutrient-icon">🍚</text>
                      <text class="nutrient-text">{{item.carbs}}g碳水</text>
                    </view>
                    <view class="nutrient-tag">
                      <text class="nutrient-icon">🥑</text>
                      <text class="nutrient-text">{{item.fat}}g脂肪</text>
                    </view>
                  </view>
                  <view class="food-category">{{item.category}}</view>
                </view>
              </view>
              
              <!-- 删除按钮 -->
              <view class="food-actions">
                <view class="food-action-btn delete" catchtap="deleteFoodItem" data-meal-type="lunch" data-index="{{index}}">
                  <image class="action-icon" src="/assets/health-profile/icon-delete.png" mode="aspectFit"></image>
                </view>
              </view>
            </view>
          </view>
          
          <!-- 空状态 -->
          <view class="meal-empty-state" wx:else bindtap="addRecipe" data-meal-type="lunch">
            <image class="empty-icon" src="/assets/index/icon-wucan.png" mode="aspectFit"></image>
            <text class="empty-text">暂无午餐食谱，点击添加</text>
          </view>
        </view>
        <!-- 晚餐 -->
        <view class="meal-section">
          <view class="meal-header">
            <image class="meal-icon" src="/assets/index/icon-wancan.png" mode="aspectFit"></image>
            <text class="meal-time">{{todayRecipe.meals.dinner.time}}</text>
            <text class="meal-time-range">{{todayRecipe.meals.dinner.timeRange}}</text>
            <text class="meal-calories">{{todayRecipe.meals.dinner.calories}}千卡</text>
          </view>
          <view class="food-list-vertical" wx:if="{{todayRecipe.meals.dinner.foods.length > 0}}">
            <view class="food-item-horizontal {{editingMealType === 'dinner' && editingItemIndex === index ? 'editing' : ''}}" 
                  wx:for="{{todayRecipe.meals.dinner.foods}}" 
                  wx:key="id" 
                  bindlongpress="onFoodLongPress"
                  catchtap="{{editingMealType === 'dinner' && editingItemIndex === index ? 'cancelEdit' : 'navigateToRecipeDetail'}}"
                  data-meal-type="dinner"
                  data-index="{{index}}"
                  data-id="{{item.id}}">
              <image class="food-item-image" src="{{item.image}}" mode="aspectFill"></image>
              <view class="food-item-content">
                <view class="food-item-header">
                  <text class="food-item-name">{{item.name}}</text>
                  <text class="food-item-amount">{{item.amount}}</text>
                </view>
                <view class="food-item-body">
                  <view class="food-item-nutrients">
                    <view class="nutrient-tag">
                      <text class="nutrient-icon">🔥</text>
                      <text class="nutrient-text">{{item.calories}}千卡</text>
                    </view>
                    <view class="nutrient-tag">
                      <text class="nutrient-icon">💪</text>
                      <text class="nutrient-text">{{item.protein}}g蛋白</text>
                    </view>
                    <view class="nutrient-tag">
                      <text class="nutrient-icon">🍚</text>
                      <text class="nutrient-text">{{item.carbs}}g碳水</text>
                    </view>
                    <view class="nutrient-tag">
                      <text class="nutrient-icon">🥑</text>
                      <text class="nutrient-text">{{item.fat}}g脂肪</text>
                    </view>
                  </view>
                  <view class="food-category">{{item.category}}</view>
                </view>
              </view>
              
              <!-- 删除按钮 -->
              <view class="food-actions">
                <view class="food-action-btn delete" catchtap="deleteFoodItem" data-meal-type="dinner" data-index="{{index}}">
                  <image class="action-icon" src="/assets/health-profile/icon-delete.png" mode="aspectFit"></image>
                </view>
              </view>
            </view>
          </view>
          
          <!-- 空状态 -->
          <view class="meal-empty-state" wx:else bindtap="addRecipe" data-meal-type="dinner">
            <image class="empty-icon" src="/assets/index/icon-wancan.png" mode="aspectFit"></image>
            <text class="empty-text">暂无晚餐食谱，点击添加</text>
          </view>
        </view>
      </view>
    </view>
    <!-- 快捷入口 -->
    <view class="quick-entry-section">
      <view class="quick-entry-item" bindtap="onNavigate" data-page="diary">
        <view class="entry-icon">
          <image class="entry-icon-image" src="/assets/index/icon-reji.png" mode="aspectFit"></image>
        </view>
        <text class="entry-text">饮食日记</text>
      </view>
      <view class="quick-entry-item" bindtap="onNavigate" data-page="health">
        <view class="entry-icon">
          <image class="entry-icon-image" src="/assets/index/icon-jiankangdangan.png" mode="aspectFit"></image>
        </view>
        <text class="entry-text">健康档案</text>
      </view>
    </view>
    <!-- 饮食打卡 -->
    <view class="section checkin-section">
      <view class="section-header">
        <text class="section-title">今日饮食打卡</text>
        <text class="section-subtitle">记录你的实际饮食</text>
      </view>
      <view class="checkin-list">
        <view class="checkin-item" wx:for="{{checkinMeals}}" wx:key="type">
          <view class="checkin-header">
            <view class="checkin-header-left">
              <image class="checkin-icon" src="{{item.icon}}" mode="aspectFit"></image>
              <text class="checkin-label">{{item.label}}</text>
              <text class="checkin-calories" wx:if="{{item.checked}}">{{item.calories}}千卡</text>
            </view>
            <view class="checkin-btn" bindtap="onCheckin" data-type="{{item.type}}">
              <text class="checkin-btn-text">{{item.checked ? '继续打卡' : '去打卡'}}</text>
            </view>
          </view>
          
          <!-- 食物列表 -->
          <view class="checkin-foods" wx:if="{{item.checked && item.foods.length > 0}}">
            <view class="food-item" wx:for="{{item.foods}}" wx:key="id" wx:for-item="food">
              <image class="food-image" src="{{food.image}}" mode="aspectFill"></image>
              <view class="food-info">
                <text class="food-name">{{food.name}}</text>
                <view class="food-nutrition">
                  <text class="nutrition-item">{{food.calories}}千卡</text>
                  <text class="nutrition-divider">|</text>
                  <text class="nutrition-item">蛋白{{food.protein}}g</text>
                  <text class="nutrition-divider">|</text>
                  <text class="nutrition-item">碳水{{food.carbs}}g</text>
                  <text class="nutrition-divider">|</text>
                  <text class="nutrition-item">脂肪{{food.fat}}g</text>
                </view>
              </view>
            </view>
          </view>
          
          <!-- 未打卡提示 -->
          <view class="checkin-empty" wx:if="{{!item.checked}}">
            <text class="empty-text">还没有打卡记录</text>
          </view>
        </view>
      </view>
    </view>
    <!-- 食物排行榜 -->
    <view class="section ranking-section">
      <view class="section-header">
        <view class="section-title-wrapper">
          <image class="section-title-icon" src="/assets/index/icon-paihangbang.png" mode="aspectFit"></image>
          <text class="section-title">食物排行榜</text>
        </view>
        <text class="section-more" bindtap="onViewRanking">TOP 10</text>
      </view>
      <view class="ranking-list">
        <view class="ranking-item" wx:for="{{rankings}}" wx:key="id" bindtap="navigateToRecipeDetail" data-id="{{item.id}}">
          <view class="ranking-badge {{item.rank <= 3 ? 'top-three rank-' + item.rank : ''}}">
            {{item.rank}}
          </view>
          <image class="ranking-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="ranking-info">
            <text class="ranking-name">{{item.name}}</text>
            <view class="ranking-meta">
              <view class="ranking-likes">
                <image class="ranking-icon" src="/assets/index/icon-shouchang.png" mode="aspectFit"></image>
                <text class="ranking-icon-text">{{item.likes}}</text>
              </view>
              <view class="ranking-views">
                <image class="ranking-icon" src="/assets/index/icon-liulan.png" mode="aspectFit"></image>
                <text class="ranking-icon-text">{{item.views}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <!-- 底部间距 -->
    <view class="bottom-space"></view>
  </view>
</scroll-view>

<!-- 生成食谱弹窗 -->
<view class="generate-modal-mask" wx:if="{{showGenerateModal}}" bindtap="closeGenerateModal">
  <view class="generate-modal" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">生成今日食谱</text>
      <view class="modal-close" catchtap="closeGenerateModal">
        <image class="close-icon" src="/assets/auth/icon-close.png" mode="aspectFit"></image>
      </view>
    </view>
    <view class="modal-body">
      <view class="modal-label">今日想法（选填）</view>
      <textarea 
        class="modal-textarea" 
        placeholder="例如：今天想吃清淡点的，多来点蔬菜..." 
        placeholder-style="color: #999;"
        maxlength="200"
        value="{{generateInput}}"
        bindinput="onGenerateInputChange"
      ></textarea>
      <view class="modal-hint">不填写将使用默认推荐方案</view>
    </view>
    <view class="modal-footer">
      <view class="modal-btn normal-btn" catchtap="onNormalGenerate">
        <text>正常生成</text>
      </view>
      <view class="modal-btn custom-btn" catchtap="onCustomGenerate">
        <text>今日想法</text>
      </view>
    </view>
  </view>
</view>
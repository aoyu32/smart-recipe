/* pages/take-picture/take-picture.wxss */
page {
  height: 100vh;
  background-color: #000;
}

.take-picture-container {
  width: 100%;
  height: 100vh;
}

/* 拍摄界面 */
.capture-view {
  width: 100%;
  height: 100vh;
}

.camera {
  width: 100%;
  height: 100vh;
}

.camera-overlay {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.camera-header {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.5) 0%, transparent 100%);
}

.camera-title {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.camera-guide {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.guide-frame {
  border: 4rpx solid rgba(182, 207, 153, 0.8);
  border-radius: 20rpx;
  box-shadow: 0 0 0 9999rpx rgba(0, 0, 0, 0.3);
}

.guide-text {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #FFFFFF;
}

.camera-controls {
  padding: 60rpx 30rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.5) 0%, transparent 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.control-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.album-btn {
  width: 120rpx;
}

.control-icon {
  width: 60rpx;
  height: 60rpx;
}

.album-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.album-icon {
  width: 50rpx;
  height: 50rpx;
}

.capture-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.capture-inner {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
}

.placeholder-btn {
  width: 120rpx;
}

/* 编辑界面 */
.edit-view {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #000;
}

.edit-header {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.8);
}

.edit-title {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.edit-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.movable-area {
  width: 100%;
  height: 100%;
}

.movable-view {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-image {
  width: 100%;
  height: 100%;
}

.edit-tools {
  padding: 20rpx 30rpx;
  background-color: rgba(0, 0, 0, 0.8);
}

.tool-buttons {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin-bottom: 15rpx;
}

.tool-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.tool-icon {
  font-size: 48rpx;
}

.tool-label {
  font-size: 24rpx;
  color: #FFFFFF;
}

.tool-tip {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.edit-actions {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background-color: rgba(0, 0, 0, 0.8);
}

.action-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 15rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.cancel-btn {
  background-color: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
}

.confirm-btn {
  background: linear-gradient(135deg, #B6CF99 0%, #9BC184 100%);
  color: #FFFFFF;
}

/* 操作选择界面 */
.action-view {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F5F5F5;
  overflow: hidden;
}

.action-header {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #B6CF99;
}

.action-title {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.action-preview {
  width: 100%;
  height: 500rpx;
  background-color: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* 空状态 */
.preview-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.3;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 重新拍摄按钮 */
.retake-btn {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  width: 80rpx;
  height: 80rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.retake-icon {
  width: 48rpx;
  height: 48rpx;
}

.action-buttons {
  display: flex;
  gap: 30rpx;
  padding: 40rpx 30rpx 20rpx;
  flex-shrink: 0;
}

.action-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

.meal-card {
  border: 3rpx solid #B6CF99;
}

.ai-card {
  border: 3rpx solid #9BC184;
}

.card-icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
}

.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.2;
}

.card-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.2;
}

.card-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.2;
}

.action-footer {
  padding: 0 30rpx 20rpx;
  display: flex;
  justify-content: center;
  flex-shrink: 0;
}

.footer-btn {
  width: 100%;
  padding: 28rpx;
  background-color: #FFFFFF;
  border-radius: 15rpx;
  text-align: center;
  font-size: 32rpx;
  color: #666;
  border: 2rpx solid #E0E0E0;
}

/* 内容区域 */
.content-area {
  flex: 1;
  overflow-y: auto;
  padding: 0 30rpx 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background-color: #F5F5F5;
}

/* 饮食打卡列表 */
.meal-checkin-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.meal-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 卡片头部 */
.meal-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #F5F5F5;
  margin-bottom: 20rpx;
}

.meal-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meal-type-icon {
  width: 40rpx;
  height: 40rpx;
}

.meal-type-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.meal-header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.add-food-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background-color: #B6CF99;
  border-radius: 20rpx;
}

.add-icon {
  width: 24rpx;
  height: 24rpx;
}

.add-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.meal-status {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background-color: #F5F5F5;
  border: 2rpx solid #E0E0E0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.meal-status.checked {
  background-color: #E8F5E0;
  border-color: #B6CF99;
}

.status-text {
  font-size: 22rpx;
  color: #999;
  line-height: 1;
}

.meal-status.checked .status-text {
  color: #B6CF99;
  font-weight: 600;
}

.meal-status-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 食物列表 */
.food-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 识别中状态 */
.recognizing-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #E8F5E0 0%, #F0F8EC 100%);
  border-radius: 16rpx;
  border: 2rpx solid #B6CF99;
  margin-bottom: 8rpx;
}

.recognizing-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #B6CF99;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }

  100% {
    transform: rotate(360deg);
  }
}

.recognizing-text {
  font-size: 28rpx;
  color: #6B8E4E;
  font-weight: 500;
}

.food-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background-color: #F8F8F8;
  border-radius: 16rpx;
}

.food-item-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.food-item.placeholder {
  border: 2rpx dashed #D0D0D0;
  background-color: #FAFAFA;
}

.food-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background-color: #E0E0E0;
}

.food-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.food-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  word-break: break-word;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-name.placeholder-text {
  color: #999;
  font-weight: 400;
}

.food-calories {
  font-size: 24rpx;
  color: #999;
}

/* 营养数据 */
.food-nutrition {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.nutrition-item {
  font-size: 22rpx;
  color: #666;
  line-height: 1;
}

.nutrition-divider {
  font-size: 22rpx;
  color: #DDD;
  line-height: 1;
}

.food-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.delete-icon {
  width: 32rpx;
  height: 32rpx;
}

/* AI回复区域 */
.ai-response-area {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
}

.ai-response-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.ai-response-item {
  width: 100%;
  box-sizing: border-box;
  animation: fadeIn 0.3s ease-in;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 标题样式 */
.ai-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx 0 12rpx 0;
}

.heading-icon {
  font-size: 36rpx;
  line-height: 1;
}

.heading-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
}

/* 列表项样式 */
.ai-list-item {
  display: flex;
  gap: 12rpx;
  margin: 8rpx 0;
  line-height: 1.8;
}

.list-bullet {
  font-size: 28rpx;
  color: #B6CF99;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.list-content {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
}

/* 文本样式 */
.text-normal {
  color: #333;
}

.text-bold {
  font-weight: 600;
  color: #B6CF99;
}

.ai-text-item {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin: 8rpx 0;
}

/* 加载动画 */
.ai-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 0;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #B6CF99;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }

  100% {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 26rpx;
  color: #B6CF99;
}